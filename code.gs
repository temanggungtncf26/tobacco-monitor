function getDashboardDataRaw(token) {
  try {
    const auth = validateSession(token);
    if (!auth.valid) return { success: false, sessionExpired: true };
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    
    const allowedPetani = getAllowedPetani(auth);
    const fCount = allowedPetani.size;
    
    const pSheet = ss.getSheetByName('VisitPlans');
    const plans = [];
    
    // Pelindung: Hanya jalankan jika Sheet ada dan ada isinya
    if (pSheet && pSheet.getLastRow() > 1) {
        const planData = pSheet.getDataRange().getValues();
        const pMap = getColumnMap(pSheet);
        for (let i = 1; i < planData.length; i++) {
          if (auth.role === 'Trader' && String(planData[i][pMap['user_id']]).toLowerCase() !== auth.username.toLowerCase()) continue;
          if (auth.role === 'PIC' || auth.role === 'PIC2') {
            const planFarmers = String(planData[i][pMap['farmer_id']] || '').split(',').map(s => s.trim());
            if (!planFarmers.some(fid => allowedPetani.has(fid))) continue;
          }
          
          plans.push({
            date: safeDateFormat(planData[i][pMap['date']]),
            field_force: planData[i][pMap['field_force']] || 'Tanpa Nama',
            status: planData[i][pMap['status']] || 'Pending'
          });
        }
    }
    return { success: true, data: { totalFarmers: fCount, plans: plans } };
  } catch (error) {
    return { success: false, message: "Error Data Backend: " + error.toString() };
  }
}

