function getFarmers(token) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Farmers');
  if (sheet.getLastRow() < 2) return { success: true, data: [] };
  const data = sheet.getDataRange().getValues();
  const map = getColumnMap(sheet);
  const result = [];
  
  for (let i = data.length - 1; i >= 1; i--) {
    const id_trader = String(data[i][map['id_trader']] || '');
    const pic = String(data[i][map['pic']] || '');
    
    if (auth.role === 'Trader' && id_trader.toLowerCase() !== auth.username.toLowerCase()) continue;
    if (auth.role === 'PIC' || auth.role === 'PIC2') {
      const targetPIC = (auth.role === 'PIC2' ? 'ROCHMAD JATI K' : auth.username).toLowerCase();
      if (pic.toLowerCase() !== targetPIC) continue;
    }
    
    result.push({
      id: data[i][map['id']], id_trader: id_trader, kode_trader: data[i][map['kode_trader']] || '',
      id_petani: data[i][map['id_petani']] || '', id_field: data[i][map['id_field']] || '',
      field_force: data[i][map['field_force']] || '', pic: pic,
      seri: data[i][map['seri']] || '', nama_koordinator: data[i][map['nama_koordinator']] || '',
      nama_petani: data[i][map['nama_petani']] || '', nama_alias: data[i][map['nama_alias']] || '',
      nik: data[i][map['nik']] || '', klaster_petani: data[i][map['klaster_petani']] || '',
      dusun: data[i][map['dusun']] || '', desa: data[i][map['desa']] || '', 
      kecamatan: data[i][map['kecamatan']] || '', kabupaten: data[i][map['kabupaten']] || '', 
      foto: data[i][map['foto']] || ''
    });
  }
  return { success: true, data: result };
}

function saveFarmer(token, payload) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  
  // Lock mechanism based on Role
  if (auth.role === 'Trader') {
    payload.id_trader = auth.username;
  } else if (auth.role === 'PIC' || auth.role === 'PIC2') {
    // If PIC adds a farmer, ensure their name is locked to the PIC field
    payload.pic = auth.username;
  }
  
  if (payload.foto && payload.foto.startsWith('data:image')) {
    var driveUrl = uploadImageToDrive(payload.foto, 'Petani_' + payload.id_petani + '_' + Date.now() + '.jpg');
    if (driveUrl) payload.foto = driveUrl;
  }

  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Farmers');
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const data = sheet.getDataRange().getValues();
    const map = getColumnMap(sheet);
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    if (payload.isEdit === 'true') {
      for (let i = 1; i < data.length; i++) {
        if (data[i][map['id']] == payload.id) {
          // Double check ownership before updating
          if (auth.role === 'Trader' && String(data[i][map['id_trader']]).toLowerCase() !== auth.username.toLowerCase()) return { success: false, message: 'Akses Ditolak' };
          const targetPIC = (auth.role === 'PIC2' ? 'ROCHMAD JATI K' : auth.username).toLowerCase();
    if ((auth.role === 'PIC' || auth.role === 'PIC2') && String(data[i][map['pic']]).toLowerCase() !== targetPIC) return { success: false, message: 'Akses Ditolak' };
          
          for (const key in payload) { if (map[key] !== undefined && key !== 'id' && key !== 'isEdit') { sheet.getRange(i + 1, map[key] + 1).setValue(payload[key]); } }
          break;
        }
      }
    } else {
      const id = Date.now();
      const newRow = new Array(headers.length).fill('');
      newRow[map['id']] = id;
      for (const key in payload) { if (map[key] !== undefined && key !== 'id' && key !== 'isEdit') newRow[map[key]] = payload[key]; }
      if (map['created_at'] !== undefined) newRow[map['created_at']] = new Date();
      sheet.appendRow(newRow);
    }
    logAction(auth.username, 'SAVE_FARMER', payload.nama_petani);
    return { success: true };
  } catch(e) { return { success: false, message: e.toString() }; }
  finally { lock.releaseLock(); }
}

