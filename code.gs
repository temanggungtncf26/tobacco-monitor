function getLands(token) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Lands');
  if (sheet.getLastRow() < 2) return { success: true, data: [] };
  const data = sheet.getDataRange().getValues();
  const map = getColumnMap(sheet);
  const result = [];
  const allowedPetani = getAllowedPetani(auth);
  
  for (let i = data.length - 1; i >= 1; i--) {
    if (auth.role !== 'Admin' && !allowedPetani.has(String(data[i][map['id_petani']]))) continue;
    result.push({
      id: data[i][map['id']], id_lahan: data[i][map['id_lahan']] || '',
      id_petani: data[i][map['id_petani']] || '', nama_lahan: data[i][map['nama_lahan']] || '',
      desa: data[i][map['desa']] || '', kecamatan: data[i][map['kecamatan']] || '',
      kabupaten: data[i][map['kabupaten']] || '', klaster: data[i][map['klaster']] || '',
      irigasi: data[i][map['irigasi']] || '', tekstur: data[i][map['tekstur']] || '',
      arah_lereng: data[i][map['arah_lereng']] || '', kemiringan: data[i][map['kemiringan']] || '',
      ketinggian: data[i][map['ketinggian']] || '', point_x: data[i][map['point_x']] || '',
      point_y: data[i][map['point_y']] || '', luas: data[i][map['luas']] || ''
    });
  }
  return { success: true, data: result };
}

function saveLand(token, payload) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  const allowedPetani = getAllowedPetani(auth);
  if (auth.role !== 'Admin' && !allowedPetani.has(String(payload.id_petani))) return { success: false, message: 'Akses Ditolak.' };
  
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Lands');
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const data = sheet.getDataRange().getValues();
    const map = getColumnMap(sheet);
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    if (payload.isEdit === 'true') {
      for (let i = 1; i < data.length; i++) {
        if (data[i][map['id']] == payload.id) {
          for (const key in payload) { if (map[key] !== undefined && key !== 'id' && key !== 'isEdit') sheet.getRange(i + 1, map[key] + 1).setValue(payload[key]); }
          break;
        }
      }
    } else {
      const id = Date.now();
      const newRow = new Array(headers.length).fill('');
      newRow[map['id']] = id;
      for (const key in payload) { if (map[key] !== undefined && key !== 'id' && key !== 'isEdit') newRow[map[key]] = payload[key]; }
      if (map['created_at'] !== undefined) newRow[map['created_at']] = new Date();
      sheet.appendRow(newRow);
    }
    logAction(auth.username, 'SAVE_LAND', payload.nama_lahan);
    return { success: true };
  } catch(e) { return { success: false, message: e.toString() }; }
  finally { lock.releaseLock(); }
}

