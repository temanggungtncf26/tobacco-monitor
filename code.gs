function getPlans(token) {
  try {
    const auth = validateSession(token);
    if (!auth.valid) return { success: false, sessionExpired: true };
    
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('VisitPlans');
    if (!sheet || sheet.getLastRow() < 2) return { success: true, data: [] };
    
    const data = sheet.getDataRange().getValues();
    const map = getColumnMap(sheet);
    const result = [];
    const allowedPetani = getAllowedPetani(auth);
    
    for (let i = data.length - 1; i >= 1; i--) {
      // Filter Trader
      if (auth.role === 'Trader' && String(data[i][map['user_id']]).toLowerCase() !== auth.username.toLowerCase()) continue;
      // Filter PIC dan PIC2
      if (auth.role === 'PIC' || auth.role === 'PIC2') {
        const planFarmers = String(data[i][map['farmer_id']] || '').split(',').map(s => s.trim());
        if (!planFarmers.some(fid => allowedPetani.has(fid))) continue;
      }
      
      // PELINDUNG ANTI-NULL: Memaksa semua output menjadi String (Teks)
      result.push({
        id: String(data[i][map['id']] || ''), 
        user_id: String(data[i][map['user_id']] || ''),
        field_force: String(data[i][map['field_force']] || ''), 
        date: safeDateFormat(data[i][map['date']]),
        periode_minggu: String(data[i][map['periode_minggu']] || ''), 
        periode_bulan: String(data[i][map['periode_bulan']] || ''),
        farmer_id: String(data[i][map['farmer_id']] || ''), 
        farmer_name: String(data[i][map['farmer_name']] || ''),
        klaster_gunung: String(data[i][map['klaster_gunung']] || '0'), 
        klaster_sawah: String(data[i][map['klaster_sawah']] || '0'),
        klaster_tegal: String(data[i][map['klaster_tegal']] || '0'), 
        klaster_lain: String(data[i][map['klaster_lain']] || '0'),
        total_petani: String(data[i][map['total_petani']] || '0'), 
        status: String(data[i][map['status']] || 'Pending')
      });
    }
    return { success: true, data: result };
  } catch (e) {
    return { success: false, message: "Error Backend: " + e.message };
  }
}

function savePlan(token, payload) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('VisitPlans');
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const map = getColumnMap(sheet);
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    const id = Date.now();
    const newRow = new Array(headers.length).fill('');
    newRow[map['id']] = id;
    for (const key in payload) {
      if (map[key] !== undefined && key !== 'id') { newRow[map[key]] = payload[key]; }
    }
    if (map['status'] !== undefined) newRow[map['status']] = 'Pending';
    if (map['created_at'] !== undefined) newRow[map['created_at']] = new Date();
    
    sheet.appendRow(newRow);
    logAction(auth.username, 'CREATE_PLAN', payload.periode_minggu);
    return { success: true };
  } catch(e) { return { success: false, message: e.toString() }; }
  finally { lock.releaseLock(); }
}

function saveRealization(token, payload) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  const allowedPlans = getAllowedPlans(auth);
  if (auth.role !== 'Admin' && !allowedPlans.has(String(payload.plan_id))) return { success: false, message: 'Akses Ditolak.' };
  
  if (payload.foto && payload.foto.startsWith('data:image')) {
    var driveUrl = uploadImageToDrive(payload.foto, 'Realization_' + payload.plan_id + '_' + Date.now() + '.jpg');
    if (driveUrl) payload.foto = driveUrl;
  }
  
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const planSheet = ss.getSheetByName('VisitPlans');
  const realSheet = ss.getSheetByName('VisitRealizations');
  
  const planData = planSheet.getDataRange().getValues();
  const pMap = getColumnMap(planSheet);
  
  for (let i = 1; i < planData.length; i++) {
    if (planData[i][pMap['id']] == payload.plan_id) {
      planSheet.getRange(i + 1, pMap['status'] + 1).setValue('Visited');
      break;
    }
  }
  
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const map = getColumnMap(realSheet);
    const headers = realSheet.getRange(1, 1, 1, realSheet.getLastColumn()).getValues()[0];
    
    const id = Date.now();
    const newRow = new Array(headers.length).fill('');
    newRow[map['id']] = id;
    for (const key in payload) {
      if (map[key] !== undefined && key !== 'id') { newRow[map[key]] = payload[key]; }
    }
    if (map['created_at'] !== undefined) newRow[map['created_at']] = new Date();
    
    realSheet.appendRow(newRow);
    logAction(auth.username, 'REALIZATION', payload.plan_id);
    return { success: true };
  } catch(e) { return { success: false, message: e.toString() }; }
  finally { lock.releaseLock(); }
}

function getRealizations(token) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('VisitRealizations');
  if (sheet.getLastRow() < 2) return { success: true, data: [] };
  const data = sheet.getDataRange().getValues();
  const map = getColumnMap(sheet);
  const result = [];
  const allowedPlans = getAllowedPlans(auth);
  const isAdmin = auth.role === 'Admin';
  
  for (let i = data.length - 1; i >= 1; i--) {
    if (!isAdmin && !allowedPlans.has(String(data[i][map['plan_id']]))) continue;
    result.push({
      id: data[i][map['id']], user_id: data[i][map['user_id']] || '',
      field_force: data[i][map['field_force']] || '', periode_minggu: data[i][map['periode_minggu']] || '',
      farmer_name: data[i][map['farmer_name']] || '', total_petani: data[i][map['total_petani']] || '',
      real_date: safeDateFormat(data[i][map['real_date']]), resume: data[i][map['resume']] || '',
      lokasi: data[i][map['lokasi']] || '', foto: data[i][map['foto']] || ''
    });
  }
  return { success: true, data: result };
}

function deletePlan(token, id) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  const allowedPlans = getAllowedPlans(auth);
  if (auth.role !== 'Admin' && !allowedPlans.has(String(id))) return { success: false, message: 'Akses Ditolak.' };
  
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('VisitPlans');
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] == id) { sheet.deleteRow(i + 1); break; }
  }
  return { success: true };
}

// ==============================
// MONITORING PERTANAMAN
// ==============================
function getPertanamans(token) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('MonPertanaman');
  if (!sheet || sheet.getLastRow() < 2) return { success: true, data: [] };
  
  const data = sheet.getDataRange().getValues();
  const map = getColumnMap(sheet);
  const result = [];
  const allowedPetani = getAllowedPetani(auth);
  
  for (let i = data.length - 1; i >= 1; i--) {
    if (auth.role !== 'Admin' && !allowedPetani.has(String(data[i][map['id_petani']]))) continue;
    
    let row = { id: data[i][map['id']] };
    Object.keys(map).forEach(k => {
      row[k] = data[i][map[k]];
      if(row[k] instanceof Date) row[k] = safeDateFormat(row[k]);
    });
    result.push(row);
  }
  return { success: true, data: result };
}

function savePertanaman(token, payload) {
  const auth = validateSession(token);
  if (!auth.valid) return { success: false, sessionExpired: true };
  
  if (payload.foto_lahan && payload.foto_lahan.startsWith('data:image')) {
    var driveUrl = uploadImageToDrive(payload.foto_lahan, 'Pertanaman_' + payload.id_lahan + '_' + Date.now() + '.jpg');
    if (driveUrl) payload.foto_lahan = driveUrl;
  }
  
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('MonPertanaman');
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const data = sheet.getDataRange().getValues();
    const map = getColumnMap(sheet);
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    if (payload.isEdit === 'true') {
      for (let i = 1; i < data.length; i++) {
        if (String(data[i][map['id']]) === String(payload.id)) {
          for (const key in payload) {
            if (map[key] !== undefined && key !== 'id' && key !== 'isEdit') {
              sheet.getRange(i + 1, map[key] + 1).setValue(payload[key]);
            }
          }
          break;
        }
      }
    } else {
      const id = Date.now();
      const newRow = new Array(headers.length).fill('');
      newRow[map['id']] = id;
      for (const key in payload) {
        if (map[key] !== undefined && key !== 'id' && key !== 'isEdit') newRow[map[key]] = payload[key];
      }
      if (map['created_at'] !== undefined) newRow[map['created_at']] = new Date();
      sheet.appendRow(newRow);
    }
    logAction(auth.username, 'SAVE_PERTANAMAN', payload.id_lahan);
    return { success: true };
  } catch(e) { return { success: false, message: e.toString() }; }
  finally { lock.releaseLock(); }
}

