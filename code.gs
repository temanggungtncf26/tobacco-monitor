// USER & PHASE MANAGEMENT (ADMIN)
// ==============================
function getUsers(token) {
  const auth = validateSession(token);
  if (!auth.valid || auth.role !== 'Admin') return { success: false, sessionExpired: !auth.valid };
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Users');
  const data = sheet.getDataRange().getValues();
  const map = getColumnMap(sheet);
  const uidCol = map['user_id'] !== undefined ? map['user_id'] : map['username'];
  const result = [];
  for (let i = 1; i < data.length; i++) {
    result.push({ user_id: data[i][uidCol], fullname: data[i][map['fullname']], role: data[i][map['role']] });
  }
  return { success: true, data: result };
}

function saveUser(token, payload) {
  const auth = validateSession(token);
  if (!auth.valid || auth.role !== 'Admin') return { success: false, message: 'Unauthorized' };
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Users');
  const lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const data = sheet.getDataRange().getValues();
    const map = getColumnMap(sheet);
    const uidCol = map['user_id'] !== undefined ? map['user_id'] : map['username'];
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    if (payload.isEdit === 'true') {
      for (let i = 1; i < data.length; i++) {
        if (String(data[i][uidCol]) === String(payload.old_user_id)) {
          sheet.getRange(i + 1, uidCol + 1).setValue(payload.user_id);
          sheet.getRange(i + 1, map['fullname'] + 1).setValue(payload.fullname);
          sheet.getRange(i + 1, map['role'] + 1).setValue(payload.role);
          if (payload.password) { sheet.getRange(i + 1, map['password'] + 1).setValue(hashPassword(payload.password)); }
          break;
        }
      }
    } else {
      for (let i = 1; i < data.length; i++) {
        if (String(data[i][uidCol]).toLowerCase() === String(payload.user_id).toLowerCase()) return { success: false, message: 'User ID sudah terdaftar!' };
      }
      const newRow = new Array(headers.length).fill('');
      newRow[uidCol] = payload.user_id; newRow[map['password']] = hashPassword(payload.password || 'Trader123');
      newRow[map['fullname']] = payload.fullname; newRow[map['role']] = payload.role;
      sheet.appendRow(newRow);
    }
    return { success: true };
  } catch(e) { return { success: false, message: e.toString() }; }
  finally { lock.releaseLock(); }
}

function deleteUser(token, user_id) {
  const auth = validateSession(token);
  if (!auth.valid || auth.role !== 'Admin') return { success: false, message: 'Unauthorized' };
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Users');
  const data = sheet.getDataRange().getValues();
  const map = getColumnMap(sheet);
  const uidCol = map['user_id'] !== undefined ? map['user_id'] : map['username'];
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][uidCol]) === String(user_id)) {
      if (data[i][map['role']] === 'Admin' && data.filter(r => r[map['role']] === 'Admin').length <= 1) return { success: false, message: 'Tidak bisa menghapus satu-satunya Admin' };
      sheet.deleteRow(i + 1);
      break;
    }
  }
  return { success: true };
}

