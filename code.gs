/**
 * ROUTER UTAMA (GET = HTML, POST = API JSON)
 */
function doGet(e) {
  return HtmlService.createTemplateFromFile('Index')
    .evaluate()
    .setTitle('Tobacco Monitor - Monitoring Perkebunan')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * API ENDPOINT untuk PWA (fetch dari GitHub Pages)
 * Menerima POST body: { action: "funcName", args: [...] }
 */
function doPost(e) {
  try {
    var payload = JSON.parse(e.postData.contents);
    var action  = payload.action;
    var args    = payload.args || [];

    var allowedActions = [
      'loginUser', 'destroySession',
      'getFarmers', 'saveFarmer',
      'getLands', 'saveLand',
      'getPlans', 'savePlan', 'deletePlan',
      'getRealizations', 'saveRealization',
      'getPertanamans', 'savePertanaman',
      'getUsers', 'saveUser', 'deleteUser',
      'getPhases', 'savePhase', 'deletePhase',
      'getDashboardDataRaw'
    ];

    if (allowedActions.indexOf(action) === -1) {
      return buildResponse({ success: false, message: 'Action tidak diizinkan: ' + action });
    }

    // Panggil fungsi sesuai action
    var result = this[action].apply(this, args);
    return buildResponse(result);

  } catch (err) {
    return buildResponse({ success: false, message: 'Server error: ' + err.toString() });
  }
}

function buildResponse(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}



/**
 * DATABASE SETUP (ROBUST VERSION)
 */
function setupDatabase() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw new Error("ERROR: Buka script ini melalui menu 'Extensions > Apps Script' di dalam Google Sheets Anda.");
  
  const tables = [
    { name: 'Farmers', headers: ['id', 'id_trader', 'kode_trader', 'id_petani', 'id_field', 'field_force', 'pic', 'seri', 'nama_koordinator', 'nama_petani', 'nama_alias', 'nik', 'klaster_petani', 'dusun', 'desa', 'kecamatan', 'kabupaten', 'foto', 'created_at'] },
    { name: 'Lands', headers: ['id', 'id_lahan', 'id_petani', 'nama_lahan', 'desa', 'kecamatan', 'kabupaten', 'klaster', 'irigasi', 'tekstur', 'arah_lereng', 'kemiringan', 'ketinggian', 'point_x', 'point_y', 'luas', 'created_at'] },
    { name: 'VisitPlans', headers: ['id', 'user_id', 'field_force', 'date', 'periode_minggu', 'periode_bulan', 'farmer_id', 'farmer_name', 'klaster_gunung', 'klaster_sawah', 'klaster_tegal', 'klaster_lain', 'total_petani', 'fase_kegiatan', 'sasaran', 'status', 'created_at'] },
    { name: 'VisitRealizations', headers: ['id', 'plan_id', 'user_id', 'field_force', 'plan_date', 'periode_minggu', 'periode_bulan', 'farmer_id', 'farmer_name', 'klaster_gunung', 'klaster_sawah', 'klaster_tegal', 'klaster_lain', 'total_petani', 'real_date', 'lokasi', 'foto', 'resume', 'created_at'] },
    { name: 'Users', headers: ['user_id', 'password', 'fullname', 'role'] },
    { name: 'ActivityPhases', headers: ['id', 'name', 'created_at'] },
    { name: 'MonPertanaman', headers: ['id', 'id_trader', 'id_petani', 'id_field', 'field_force', 'pic', 'nama_koordinator', 'nama_petani', 'nama_alias', 'id_lahan', 'klaster_petani', 'nama_lahan', 'desa', 'kecamatan', 'kabupaten', 'klaster_lahan', 'point_x', 'point_y', 'luas', 'tanggal_tanam', 'rafraksi', 'model_tanam', 'jarak_tanam', 'est_populasi', 'varietas_dominan', 'persen_dominan', 'varietas_sekunder', 'persen_sekunder', 'foto_lahan', 'created_at'] },
    { name: 'AuditLog', headers: ['timestamp', 'username', 'action', 'detail'] }
  ];
  
  tables.forEach(t => {
    let sheet = ss.getSheetByName(t.name);
    if (!sheet) {
      sheet = ss.insertSheet(t.name);
      sheet.appendRow(t.headers);
      sheet.setFrozenRows(1);
    } else {
      const lastCol = sheet.getLastColumn();
      if (lastCol === 0) {
        sheet.appendRow(t.headers);
        sheet.setFrozenRows(1);
      } else {
        const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
        t.headers.forEach(h => {
          if (headers.indexOf(h) === -1) {
            sheet.getRange(1, headers.length + 1).setValue(h);
            headers.push(h);
          }
        });
      }
    }
  });
  
  const userSheet = ss.getSheetByName('Users');
  if (userSheet && userSheet.getLastRow() <= 2) {
    const data = userSheet.getDataRange().getValues();
    let hasAdmin = false;
    for (let i = 1; i < data.length; i++) { if (data[i][0] === 'admin') hasAdmin = true; }
    if (!hasAdmin) {
      userSheet.appendRow(['admin', hashPassword('Admin@2026'), 'Super Admin', 'Admin']);
      userSheet.appendRow(['JJ', hashPassword('Admin@2026'), 'Trader Area JJ', 'Trader']);
    }
  }

  const phaseSheet = ss.getSheetByName('ActivityPhases');
  if (phaseSheet && phaseSheet.getLastRow() <= 1) {
    phaseSheet.appendRow([Date.now(), 'Pembibitan', new Date()]);
    phaseSheet.appendRow([Date.now()+1, 'Pertanaman', new Date()]);
    phaseSheet.appendRow([Date.now()+2, 'Verifikasi Varietas', new Date()]);
  }
}

/**
 * SECURITY & AUTH HELPERS
 */
function hashPassword(password) {
  var rawHash = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, password);
  var txtHash = '';
  for (var i = 0; i < rawHash.length; i++) {
    var hashVal = rawHash[i];
    if (hashVal < 0) hashVal += 256;
    if (hashVal.toString(16).length === 1) txtHash += '0';
    txtHash += hashVal.toString(16);
  }
  return txtHash;
}

function generateSessionToken(username, role) {
  var token = Utilities.getUuid();
  CacheService.getScriptCache().put('session_' + token, JSON.stringify({ username: username, role: role, created: new Date().toISOString() }), 28800);
  return token;
}

function validateSession(token) {
  if (!token) return { valid: false, message: 'Token missing' };
  var sessionData = CacheService.getScriptCache().get('session_' + token);
  if (!sessionData) return { valid: false, message: 'Session expired' };
  var parsed = JSON.parse(sessionData);
  return { valid: true, username: parsed.username, role: parsed.role };
}

function destroySession(token) {
  CacheService.getScriptCache().remove('session_' + token);
  return { success: true };
}

function loginUser(username, password) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Users');
  if (!sheet) return { success: false, message: 'Jalankan setupDatabase() terlebih dahulu' };
  
  const data = sheet.getDataRange().getValues();
  const map = getColumnMap(sheet);
  const uidCol = map['user_id'] !== undefined ? map['user_id'] : map['username'];
  const hashedInput = hashPassword(password);
  
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][uidCol]).toLowerCase() === String(username).toLowerCase() && data[i][map['password']] === hashedInput) {
      const role = data[i][map['role']];
      const token = generateSessionToken(data[i][uidCol], role);
      logAction(data[i][uidCol], 'LOGIN', 'Masuk ke sistem');
      return { success: true, token: token, user: { username: data[i][uidCol], fullname: data[i][map['fullname']], role: role } };
    }
  }
  return { success: false, message: 'User ID atau Password salah!' };
}

function logAction(username, action, detail) {
  try { SpreadsheetApp.getActiveSpreadsheet().getSheetByName('AuditLog').appendRow([new Date(), username, action, detail]); } catch (e) {}
}

/**
 * CORE DATA HELPERS
 */
function getColumnMap(sheet) {
  const lastCol = sheet.getLastColumn();
  if (lastCol === 0) return {};
  const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  const map = {};
  headers.forEach((h, i) => map[String(h).toLowerCase().trim()] = i);
  return map;
}

function safeDateFormat(value) {
  if (!value || !(value instanceof Date)) return String(value || '');
  return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function getAllowedPetani(auth) {
  const farmerSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Farmers');
  if (!farmerSheet) return new Set();
  const fData = farmerSheet.getDataRange().getValues();
  const fMap = getColumnMap(farmerSheet);
  const allowed = new Set();
  
  const isAdmin = auth.role === 'Admin';
  const isTrader = auth.role === 'Trader';
  const isPIC = auth.role === 'PIC' || auth.role === 'PIC2';
  for(let i=1; i<fData.length; i++) {
    const id_trader = String(fData[i][fMap['id_trader']] || '');
    const pic = String(fData[i][fMap['pic']] || '');
    if (isAdmin) {
      allowed.add(String(fData[i][fMap['id_petani']]));
    } else if (isTrader && id_trader.toLowerCase() === auth.username.toLowerCase()) {
      allowed.add(String(fData[i][fMap['id_petani']]));
    } else if (isPIC) {
      // Jika PIC2, targetnya selalu ROCHMAD JATI K. Jika PIC biasa, targetnya namanya sendiri.
      const targetPIC = (auth.role === 'PIC2' ? 'ROCHMAD JATI K' : auth.username).toLowerCase();
      if (pic.toLowerCase() === targetPIC) {
        allowed.add(String(fData[i][fMap['id_petani']]));
      }
    }
  }
  return allowed;
}

function getAllowedPlans(auth) {
  const allowedPetani = getAllowedPetani(auth);
  const planSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('VisitPlans');
  if (!planSheet) return new Set();
  const pData = planSheet.getDataRange().getValues();
  const pMap = getColumnMap(planSheet);
  const allowedPlans = new Set();
  const isAdmin = auth.role === 'Admin';
  const isTrader = auth.role === 'Trader';
  // PIC2 ditambahkan di sini
  const isPIC = auth.role === 'PIC' || auth.role === 'PIC2';
  for(let i=1; i<pData.length; i++) {
    if (isAdmin) {
      allowedPlans.add(String(pData[i][pMap['id']]));
    } else if (isTrader && String(pData[i][pMap['user_id']]).toLowerCase() === auth.username.toLowerCase()) {
      allowedPlans.add(String(pData[i][pMap['id']]));
    } else if (isPIC) {
      // PIC access depends on if any of the plan's farmers belong to this PIC
      const planFarmers = String(pData[i][pMap['farmer_id']] || '').split(',').map(s => s.trim());
      if (planFarmers.some(fid => allowedPetani.has(fid))) {
        allowedPlans.add(String(pData[i][pMap['id']]));
      }
    }
  }
  return allowedPlans;
}

function uploadImageToDrive(base64Data, filename) {
  try {
    var folders = DriveApp.getFoldersByName("TobaccoMonitor_Photos");
    var folder = folders.hasNext() ?
      folders.next() : DriveApp.createFolder("TobaccoMonitor_Photos");
    var contentType = base64Data.substring(5, base64Data.indexOf(';'));
    var bytes = Utilities.base64Decode(base64Data.split(',')[1]);
    var blob = Utilities.newBlob(bytes, contentType, filename);
    var file = folder.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    
    // Memaksa Google Drive memberikan Direct Link Image, bukan Web Viewer
    return 'https://drive.google.com/uc?export=view&id=' + file.getId(); 
  } catch(e) { return '';
  }
}

